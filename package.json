{
  "name": "@malkos911/tryon-web",
  "version": "1.0.0",
  "description": "Essayage virtuel (photo + caméra) intégrable sur tout site web, 100% dans le navigateur",
  "type": "module",
  "main": "public/tryon/tryon.js",
  "browser": "public/tryon/tryon.js",
  "exports": {
    ".": "./public/tryon/tryon.js",
    "./tryon.js": "./public/tryon/tryon.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "tryon-web": "bin/tryon-web.mjs"
  },
  "files": [
    "bin/",
    "public/tryon/tryon.js",
    "public/tryon/models/pose_landmarker_lite.task",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "prepare": "node scripts/setup.mjs",
    "prepublishOnly": "node --check public/tryon/tryon.js && node -e \"require('fs').statSync('public/tryon/models/pose_landmarker_lite.task')\"",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:render": "node tests/render.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1"
  },
  "devDependencies": {
    "express": "^5.3.0",
    "puppeteer": "^24.0.0"
  },
  "author": "Malek Maoua",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malek-95/tryon-widget.git"
  },
  "homepage": "https://github.com/malek-95/tryon-widget#readme",
  "bugs": {
    "url": "https://github.com/malek-95/tryon-widget/issues"
  },
  "keywords": [
    "virtual-try-on",
    "essayage-virtuel",
    "e-commerce",
    "mediapipe",
    "pose",
    "widget"
  ],
  "engines": {
    "node": ">=18"
  }
}
